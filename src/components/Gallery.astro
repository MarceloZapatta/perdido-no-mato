---
import { getImage } from "astro:assets";

type GalleryImage = ImageMetadata | { src: ImageMetadata; alt?: string };

const { images = [] } = Astro.props as { images: GalleryImage[] };

const items = await Promise.all(
  images.map(async (item) => {
    const src = "width" in item ? item : item.src;
    const alt = "alt" in item ? (item.alt ?? "") : "";
    const thumb = await getImage({ src, width: 600, height: 600, fit: "cover", format: "webp", quality: 70 });
    const full = await getImage({ src, format: "webp", quality: 82 });
    return { alt, thumb: thumb.src, full: full.src, width: src.width, height: src.height };
  }),
);

const single = items.length === 1;
const gridClass = single
  ? "grid-cols-1"
  : items.length === 2
    ? "grid-cols-2"
    : "grid-cols-2 sm:grid-cols-3";
---

<div class:list={["pswp-gallery my-8 grid gap-3", gridClass]}>
  {
    items.map((item) => (
      <a
        href={item.full}
        data-pswp-width={item.width}
        data-pswp-height={item.height}
        target="_blank"
        rel="noreferrer"
        class:list={[
          "block overflow-hidden rounded-md",
          single ? "" : "aspect-square",
        ]}
      >
        <img
          src={single ? item.full : item.thumb}
          alt={item.alt}
          loading="lazy"
          width={single ? item.width : 600}
          height={single ? item.height : 600}
          class:list={[
            "w-full object-cover transition-transform duration-300 hover:scale-105",
            single ? "h-auto" : "h-full",
          ]}
        />
      </a>
    ))
  }
</div>

<script>
  import PhotoSwipeLightbox from "photoswipe/lightbox";
  import "photoswipe/style.css";

  document.querySelectorAll<HTMLElement>(".pswp-gallery").forEach((gallery) => {
    const lightbox = new PhotoSwipeLightbox({
      gallery,
      children: "a",
      pswpModule: () => import("photoswipe"),
    });
    lightbox.init();
  });
</script>
