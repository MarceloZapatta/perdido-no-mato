---
import { SITE, authors } from "../../config/theme.config.ts";

export function getStaticPaths() {
  return authors.map((author) => ({ params: { slug: author.slug } }));
}

const target = `/autores/${Astro.params.slug}`;
---

<!doctype html>
<html lang={SITE.language}>
  <head>
    <meta charset="utf-8" />
    <title>Redirecionando para {target}</title>
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={new URL(target, SITE.url).href} />
  </head>
  <body>
    <a href={target}>Esta página mudou para <code>{target}</code></a>
  </body>
</html>
