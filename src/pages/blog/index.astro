---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import PostCard from "../../components/PostCard.astro";
import Icon from "../../components/Icon.astro";
import { SITE, categories, sortedPosts, tags } from "../../lib/blog-data.js";

const posts = await sortedPosts();

/* Options with no post behind them are dropped, so no filter is a dead end. The
   build-time counts are what a visitor without JavaScript sees; the script keeps
   them in step with the other active filters. */
const categoryOptions = categories
  .map((category) => ({
    ...category,
    count: posts.filter((post) => post.category === category.slug).length,
  }))
  .filter((category) => category.count > 0);

const tagOptions = tags
  .map((tag) => ({ ...tag, count: posts.filter((post) => post.tags.includes(tag.slug)).length }))
  .filter((tag) => tag.count > 0);
---

<BaseLayout
  title={`Arquivo - ${SITE.name}`}
  description="Todos os ensaios, diários de campo e entrevistas publicados. Busque e filtre por categoria ou tag."
  canonical="/blog"
>
  <div class="mx-auto max-w-4xl px-5 py-12" data-archive>
    <Breadcrumbs items={[{ label: "Início", to: "/" }, { label: "Arquivo" }]} />
    <h1 class="mt-4 font-serif text-4xl font-semibold sm:text-5xl">O arquivo</h1>
    <p class="mt-3 max-w-xl text-muted-foreground">
      Tudo o que publicamos. {posts.length} textos entre ensaios, diários de campo e entrevistas.
    </p>

    <form data-archive-search class="mt-8 flex items-center gap-2 border-b border-border pb-2">
      <Icon name="search" class="h-4 w-4 text-muted-foreground" />
      <input
        data-archive-query
        name="q"
        aria-label="Buscar no arquivo"
        placeholder="Buscar no arquivo..."
        class="w-full border-0 bg-transparent py-2 outline-none placeholder:text-muted-foreground"
      />
      <button
        data-archive-clear
        type="button"
        class="text-xs text-muted-foreground hover:text-foreground"
        hidden
      >
        Limpar
      </button>
    </form>

    {/* Progressive: without JavaScript each menu row is an ordinary link to its
        category or tag page; with it the rows filter this list in place. */}
    <div class="relative mt-6 flex flex-wrap items-center gap-2" data-archive-filters>
      <details class="group relative" data-filter-menu>
        <summary class="filter-pill">
          <span class="filter-pill-label">Categoria</span>
          <span class="filter-pill-value" data-filter-label="cat">Todas</span>
          <Icon name="chevron-down" class="h-3 w-3 transition-transform group-open:rotate-180" />
        </summary>
        {/* Links, so aria-current marks the selection - aria-pressed is button-only. */}
        <nav class="filter-popover" aria-label="Filtrar por categoria">
          <a href="/blog" class="facet" data-filter="cat" data-value="" aria-current="true">
            <span class="facet-label">Todas as categorias</span>
            <span class="facet-count" data-facet-count>{posts.length}</span>
          </a>
          {
            categoryOptions.map((category) => (
              <a
                href={`/categories/${category.slug}`}
                class="facet"
                data-filter="cat"
                data-value={category.slug}
              >
                <span class="facet-label">{category.name}</span>
                <span class="facet-count" data-facet-count>
                  {category.count}
                </span>
              </a>
            ))
          }
        </nav>
      </details>

      <details class="group relative" data-filter-menu>
        <summary class="filter-pill">
          <span class="filter-pill-label">Tag</span>
          <span class="filter-pill-value" data-filter-label="tag">Qualquer uma</span>
          <Icon name="chevron-down" class="h-3 w-3 transition-transform group-open:rotate-180" />
        </summary>
        <nav class="filter-popover" aria-label="Filtrar por tag">
          <a href="/blog" class="facet" data-filter="tag" data-value="" aria-current="true">
            <span class="facet-label">Qualquer tag</span>
            <span class="facet-count" data-facet-count>{posts.length}</span>
          </a>
          {
            tagOptions.map((tag) => (
              <a href={`/tags/${tag.slug}`} class="facet" data-filter="tag" data-value={tag.slug}>
                <span class="facet-label">#{tag.name}</span>
                <span class="facet-count" data-facet-count>
                  {tag.count}
                </span>
              </a>
            ))
          }
        </nav>
      </details>

      <button type="button" class="filter-reset" data-filter-reset hidden>Limpar filtros</button>
    </div>

    <div data-archive-count class="mt-6 text-sm text-muted-foreground"></div>

    <div data-archive-empty class="mt-12 rounded-md border border-dashed border-border py-20 text-center" hidden>
      <div class="font-serif text-lg">Nenhum resultado</div>
      <p class="mt-2 text-sm text-muted-foreground">Tente outra palavra ou limpe os filtros.</p>
    </div>

    <div data-archive-list>
      {posts.map((post) => <PostCard post={post} variant="list" />)}
    </div>

    <div data-archive-more-wrap class="mt-10 text-center" hidden>
      <button
        type="button"
        data-archive-more
        class="rounded-md border border-border px-5 py-2.5 text-sm font-medium hover:bg-muted"
      ></button>
      <div data-archive-page class="mt-3 text-xs text-muted-foreground"></div>
    </div>
  </div>
</BaseLayout>

<script>
  const archive = document.querySelector("[data-archive]");
  if (archive) {
    const pageSize = 5;
    const input = archive.querySelector("[data-archive-query]");
    const clear = archive.querySelector("[data-archive-clear]");
    const form = archive.querySelector("[data-archive-search]");
    const count = archive.querySelector("[data-archive-count]");
    const empty = archive.querySelector("[data-archive-empty]");
    const cards = [...archive.querySelectorAll("[data-post-card]")];
    const moreWrap = archive.querySelector("[data-archive-more-wrap]");
    const more = archive.querySelector("[data-archive-more]");
    const pageText = archive.querySelector("[data-archive-page]");
    const filterBar = archive.querySelector("[data-archive-filters]");
    const menus = [...archive.querySelectorAll("[data-filter-menu]")];
    const facets = [...archive.querySelectorAll("[data-filter]")];
    const reset = archive.querySelector("[data-filter-reset]");
    const emptyLabels = { cat: "Todas", tag: "Qualquer uma" };

    /* An unknown value in the URL is dropped rather than emptying the list. */
    const knownValue = (key, value) =>
      !value || archive.querySelector(`[data-filter="${key}"][data-value="${CSS.escape(value)}"]`);

    const stateFromUrl = () => {
      const params = new URLSearchParams(window.location.search);
      const cat = params.get("cat") || "";
      const tag = params.get("tag") || "";
      return {
        q: params.get("q") || "",
        cat: knownValue("cat", cat) ? cat : "",
        tag: knownValue("tag", tag) ? tag : "",
        page: Math.max(1, Number.parseInt(params.get("page") || "1", 10) || 1),
      };
    };

    const closeMenus = (except = null) => {
      menus.forEach((menu) => {
        if (menu !== except) menu.removeAttribute("open");
      });
    };

    /** Does this card survive `test`, a (possibly hypothetical) filter state? */
    const matchesState = (card, test) => {
      if (test.cat && card.dataset.category !== test.cat) return false;
      if (test.tag && !(card.dataset.tags || "").split(" ").includes(test.tag)) return false;
      if (test.q && !(card.dataset.search || "").includes(test.q)) return false;
      return true;
    };

    const writeUrl = (state) => {
      const params = new URLSearchParams();
      if (state.q) params.set("q", state.q);
      if (state.cat) params.set("cat", state.cat);
      if (state.tag) params.set("tag", state.tag);
      if (state.page > 1) params.set("page", String(state.page));
      const query = params.toString();
      history.pushState(state, "", query ? `/blog?${query}` : "/blog");
    };

    /* Each option is counted against the *other* active filters, so a row says what
       choosing it would show. Options that would return nothing are dimmed rather
       than removed, so the menu never changes length under the pointer. */
    const renderFacets = (test) => {
      facets.forEach((facet) => {
        const key = facet.dataset.filter;
        const value = facet.dataset.value || "";
        const selected = test[key] === value;
        if (selected) facet.setAttribute("aria-current", "true");
        else facet.removeAttribute("aria-current");

        const count = cards.filter((card) => matchesState(card, { ...test, [key]: value })).length;
        const countNode = facet.querySelector("[data-facet-count]");
        if (countNode) countNode.textContent = String(count);
        facet.toggleAttribute("data-empty", count === 0 && !selected);
      });

      archive.querySelectorAll("[data-filter-label]").forEach((node) => {
        const key = node.dataset.filterLabel;
        const active = test[key];
        const menu = node.closest("[data-filter-menu]");
        if (menu) menu.toggleAttribute("data-active", Boolean(active));
        const label = archive
          .querySelector(`[data-filter="${key}"][data-value="${CSS.escape(active)}"] .facet-label`)
          ?.textContent.trim();
        node.textContent = active && label ? label : emptyLabels[key];
      });

      if (reset) reset.hidden = !(test.cat || test.tag);
    };

    const render = (state, updateInput = true) => {
      if (updateInput) input.value = state.q;
      clear.hidden = !state.q;

      const test = { ...state, q: state.q.toLowerCase() };
      const matches = cards.filter((card) => matchesState(card, test));

      const visibleCount = Math.min(matches.length, state.page * pageSize);
      cards.forEach((card) => (card.hidden = true));
      matches.slice(0, visibleCount).forEach((card) => (card.hidden = false));

      count.textContent = `${matches.length} ${matches.length === 1 ? "resultado" : "resultados"}${state.q ? ` para "${state.q}"` : ""}`;
      empty.hidden = matches.length > 0;

      const totalPages = Math.max(1, Math.ceil(matches.length / pageSize));
      moreWrap.hidden = visibleCount >= matches.length;
      more.textContent = `Carregar mais (${matches.length - visibleCount} restantes)`;
      pageText.textContent = `Página ${state.page} de ${totalPages}`;

      renderFacets(test);
    };

    let state = stateFromUrl();
    render(state);

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      state = { ...state, q: input.value.trim(), page: 1 };
      writeUrl(state);
      render(state, false);
    });

    clear.addEventListener("click", () => {
      state = { ...state, q: "", page: 1 };
      writeUrl(state);
      render(state);
    });

    facets.forEach((facet) => {
      facet.addEventListener("click", (event) => {
        /* The rows are real links for the no-JS case; take over only when JS runs. */
        event.preventDefault();
        const key = facet.dataset.filter;
        const value = facet.dataset.value || "";
        /* Choosing the active option again clears that filter. */
        state = { ...state, [key]: state[key] === value ? "" : value, page: 1 };
        writeUrl(state);
        render(state);
        closeMenus();
      });
    });

    reset?.addEventListener("click", () => {
      state = { ...state, cat: "", tag: "", page: 1 };
      writeUrl(state);
      render(state);
      closeMenus();
    });

    /* One menu open at a time; clicking outside or pressing Escape closes it. */
    menus.forEach((menu) => {
      menu.addEventListener("toggle", () => {
        if (menu.open) closeMenus(menu);
      });
    });

    document.addEventListener("click", (event) => {
      const target = event.target instanceof Element ? event.target : null;
      if (!target?.closest("[data-filter-menu]")) closeMenus();
    });

    filterBar?.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      const open = menus.find((menu) => menu.open);
      if (!open) return;
      open.removeAttribute("open");
      open.querySelector("summary")?.focus();
    });

    more.addEventListener("click", () => {
      state = { ...state, page: state.page + 1 };
      writeUrl(state);
      render(state, false);
    });

    window.addEventListener("popstate", () => {
      state = stateFromUrl();
      render(state);
    });
  }
</script>
